{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Visibility Tool Schemas",
  "description": "OpenAI-compatible function schemas for Visibility tools",
  "tools": [
    {
      "name": "visibility_track",
      "description": "Record a new event to the visibility tracker",
      "input_schema": {
        "type": "object",
        "required": ["type", "name"],
        "properties": {
          "type": {
            "type": "string",
            "enum": ["request", "error", "llm", "metric", "trace", "budget", "custom"],
            "description": "The type of event to record"
          },
          "name": {
            "type": "string",
            "description": "Stable event name identifier"
          },
          "level": {
            "type": "string",
            "enum": ["debug", "info", "warn", "error"],
            "description": "Log level for the event"
          },
          "status": {
            "type": "string",
            "enum": ["success", "failure"],
            "description": "Operation status"
          },
          "duration_ms": {
            "type": "number",
            "description": "Duration in milliseconds"
          },
          "request": {
            "type": "object",
            "description": "Request details for request-type events",
            "properties": {
              "method": {"type": "string"},
              "url": {"type": "string"},
              "route": {"type": "string"},
              "status_code": {"type": "integer"},
              "headers": {"type": "object"}
            }
          },
          "error": {
            "type": "object",
            "description": "Error details for error-type events",
            "properties": {
              "message": {"type": "string"},
              "name": {"type": "string"},
              "stack": {"type": "string"},
              "code": {"type": "string"}
            }
          },
          "llm": {
            "type": "object",
            "description": "LLM call details for llm-type events",
            "properties": {
              "provider": {"type": "string"},
              "model": {"type": "string"},
              "prompt_tokens": {"type": "integer"},
              "completion_tokens": {"type": "integer"},
              "total_tokens": {"type": "integer"},
              "estimated_cost_usd": {"type": "number"},
              "agent_id": {"type": "string"},
              "session_id": {"type": "string"},
              "tool_name": {"type": "string"}
            }
          },
          "context": {
            "type": "object",
            "description": "Additional context metadata"
          },
          "tags": {
            "type": "array",
            "items": {"type": "string"},
            "description": "Event tags for categorization"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "event": {"type": "object"}
        }
      }
    },
    {
      "name": "visibility_query",
      "description": "Query stored events with filters",
      "input_schema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "description": "Filter by event type"
          },
          "name": {
            "type": "string",
            "description": "Filter by event name"
          },
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "Start timestamp (ISO 8601)"
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "description": "End timestamp (ISO 8601)"
          },
          "limit": {
            "type": "integer",
            "default": 20,
            "description": "Maximum number of events to return"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "events": {
            "type": "array",
            "items": {"type": "object"}
          }
        }
      }
    },
    {
      "name": "visibility_summary",
      "description": "Generate a usage summary report",
      "input_schema": {
        "type": "object",
        "properties": {
          "since": {
            "type": "string",
            "format": "date-time",
            "description": "Start timestamp (ISO 8601)"
          },
          "until": {
            "type": "string",
            "format": "date-time",
            "description": "End timestamp (ISO 8601)"
          }
        }
      },
      "output_schema": {
        "type": "object",
        "properties": {
          "ok": {"type": "boolean"},
          "summary": {
            "type": "object",
            "properties": {
              "total_events": {"type": "integer"},
              "total_requests": {"type": "integer"},
              "total_errors": {"type": "integer"},
              "total_llm_calls": {"type": "integer"},
              "total_prompt_tokens": {"type": "integer"},
              "total_completion_tokens": {"type": "integer"},
              "total_tokens": {"type": "integer"},
              "estimated_cost_usd": {"type": "number"},
              "top_models": {
                "type": "array",
                "items": {"type": "object"}
              },
              "recent_errors": {
                "type": "array",
                "items": {"type": "object"}
              },
              "budget": {"type": "object"}
            }
          }
        }
      }
    }
  ]
}
